{
	"name": "native-print",
	"version": "2.0.1",
	"description": "Print Obsidian notes on desktop and Android.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
    		"build": "node node_modules/typescript/bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    		"deploy": "sh deploy.sh",
    		"lint": "node node_modules/eslint/bin/eslint src --ext .ts",
    		"version": "node version-bump.mjs && git add manifest.json versions.json",
    		"test": "node node_modules/vitest/vitest.mjs run",
    		"test:watch": "node node_modules/vitest/vitest.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.0",
		"eslint": "^8.56.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.9.3",
		"vitest": "^1.6.0"
	}
}
